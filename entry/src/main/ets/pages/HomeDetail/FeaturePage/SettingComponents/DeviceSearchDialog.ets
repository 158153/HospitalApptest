/**
 * 设备搜索弹窗组件：用于展示设备搜索中的加载状态，提供取消搜索的交互
 * @component 标记为鸿蒙自定义组件
 * @export 导出组件，供其他页面导入使用
 */
@Component
export struct DeviceSearchDialog {
  /**
   * 取消搜索的回调函数：点击"取消"按钮时触发
   * 修复点：初始化为空函数，避免组件使用时未传入回调导致"未赋值"的类型报错
   * 类型约束：无参数、无返回值的函数类型
   */
  onCancel: () => void = () => {
  }

  /**
   * 组件UI构建方法：鸿蒙组件的核心渲染入口，所有UI元素都在此定义
   */
  build() {
    // 外层列布局容器：垂直排列子元素，是组件的根容器
    Column() {
      // ---------- 搜索动画区域（堆叠布局实现多层圆形动效） ----------
      Stack() { // 堆叠布局：子元素按顺序层叠显示（后定义的在上方）
        Circle() // 鸿蒙内置的圆形基础组件
          .width(80)               // 圆形宽度80vp（鸿蒙虚拟像素）
          .height(80)              // 圆形高度80vp（宽高一致才是正圆）
          .fill("#E0F2F1") // 填充色：浅青绿色（与主页面风格统一）

        // 中间层圆形：透明度0.6，营造层次感
        Circle()
          .width(120)              // 宽度120vp（比内层大）
          .height(120)             // 高度120vp
          .fill("#E0F2F1")         // 同色系填充
          .opacity(0.6) // 透明度60%（半透明）

        // 外层圆形：透明度0.3，最外层，弱化显示
        Circle()
          .width(160)              // 宽度160vp（最大）
          .height(160)             // 高度160vp
          .fill("#E0F2F1")         // 同色系填充
          .opacity(0.3) // 透明度30%（更浅）
      }
      .margin({ top: 20, bottom: 20 }) // 动画区域上下外边距20vp，与其他元素分隔

      // ---------- 提示文本区域 ----------
      Text("正在搜索附近设备...")      // 提示用户当前状态的文本
        .fontSize(16)                  // 字体大小16vp（适配移动端阅读）
        .fontColor("#666666")          // 字体颜色：深灰色（不刺眼，符合UI规范）
        .margin({ bottom: 30 }) // 文本下方外边距30vp，与按钮分隔

      // ---------- 取消按钮区域 ----------
      Button("取消")                   // 鸿蒙内置按钮组件，显示"取消"文字
        .width("80%")                 // 按钮宽度占父容器（Column）的80%
        .height(40)                   // 按钮高度40vp（符合移动端按钮高度规范）
        .backgroundColor("#E0F2F1")   // 按钮背景色：与主页面/动画同色系，风格统一
        .fontColor("#333333")         // 按钮文字颜色：深黑色（保证可读性）
        .onClick(this.onCancel) // 绑定点击事件：触发外部传入的取消回调函数

    }
    // ---------- 外层Column容器样式 ----------
    .width("85%") // 弹窗整体宽度占父容器的90%（留边距，避免贴边）
    .padding(20) // 容器内边距20vp：所有子元素与容器边缘的距离
    .backgroundColor(Color.White) // 弹窗背景色：白色（突出弹窗，区分遮罩层）
    .borderRadius(15) // 圆角12vp：柔化弹窗边角，符合现代UI设计
    .alignItems(HorizontalAlign.Center) // 子元素水平居中对齐（动画、文本、按钮都居中）
  }
}